# Database Configuration
DATABASE_URL=jdbc:sqlite:./data/app.db

# Confluence Configuration
CONFLUENCE_URL=https://your-confluence-instance.atlassian.net
CONFLUENCE_USERNAME=your-email@example.com
CONFLUENCE_API_TOKEN=your-api-token
CONFLUENCE_DEFAULT_SPACE=YOUR_SPACE_KEY
CONFLUENCE_PROVIDER_TYPE=confluence-server

# Storage Configuration
ATTACHMENTS_DIR=storage/attachments

# Scheduler Configuration
SCHEDULER_INTERVAL_SECONDS=60
